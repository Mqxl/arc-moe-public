+bool Prefill::pin_lent_slots(const std::vector<std::pair<int32_t, int32_t>>& slots, std::string& err) {
+    const char* v = std::getenv("STRATA_PF_PIN_LOAN");
+    if (!v || v[0] != '1' || slots.empty()) return true;
+    Impl& m = *impl_;
+    const auto& layout = strata::kernels::cpu::expert_layout();
+    if (!m.cache || !m.g || !layout.native) return true;
+    uint64_t available = 0;
+    std::ifstream info("/proc/meminfo");
+    std::string line;
+    while (std::getline(info, line))
+        if (line.rfind("MemAvailable:", 0) == 0) available = std::strtoull(line.c_str() + 13, nullptr, 10) * 1024;
+    // Keep half of currently available host RAM. If pinning is unavailable the existing Stager stays active.
+    uint64_t budget = available / 2;
+    size_t needed = 0;
+    for (const auto& en : slots) if (!m.pinned_loan.count(en.first))
+        needed += (layout.blob_bytes(en.first / m.g->n_expert) + 255) & ~(size_t)255;
+    if (!needed || !budget) return true;
+    uint8_t* chunk = nullptr;
+    size_t left = 0, bytes = 0;
+    int count = 0;
+    sycl::event done;
+    const auto start = Clock::now();
+    try {
+        for (const auto& en : slots) {
+            if (m.pinned_loan.count(en.first)) continue;
+            const size_t blob = layout.blob_bytes(en.first / m.g->n_expert);
+            const size_t stride = (blob + 255) & ~(size_t)255;
+            if (stride > left) {
+                const size_t take = std::min<uint64_t>({1ull << 30, budget, needed});
+                if (take < stride) break;
+                try { chunk = (uint8_t*)sycl::malloc_host(take, *m.copy); }
+                catch (const sycl::exception&) { chunk = nullptr; }
+                if (!chunk) break;
+                m.owned.push_back(chunk);
+                budget -= take;
+                left = take;
+            }
+            done = m.copy->memcpy(chunk, m.cache->device_slot(en.second), blob);
+            m.pinned_loan.emplace(en.first, chunk);
+            chunk += stride; left -= stride; needed -= stride;
+            bytes += blob; ++count;
+        }
+        if (count) done.wait_and_throw();
+    } catch (const std::exception& ex) {
+        err = std::string("prefill: pinning lent experts: ") + ex.what();
+        return false;
+    }
+    if (count) std::fprintf(stderr, "strata prefill: pin loan %d experts, %.1f MiB in %.1f ms; pinned entries %zu\n",
+                           count, bytes / 1048576.0, ms_since(start), m.pinned_loan.size());
+    return true;
+}
