 sycl/src/core/weights.cpp                 |  1 +
 2 files changed, 17 insertions(+)

diff --git a/sycl/include/strata/sycl_dense_upload.hpp b/sycl/include/strata/sycl_dense_upload.hpp
index f1f51c3..a071c43 100644
--- a/sycl/include/strata/sycl_dense_upload.hpp
+++ b/sycl/include/strata/sycl_dense_upload.hpp
@@ -2,12 +2,28 @@
 #include <sycl/sycl.hpp>
 #include <cstdint>
 #include <cstdlib>
+#include <cstdio>
 namespace strata {
 // Startup-only diagnostic alternative to the runtime memcpy. The source must
 // be host USM. Zero retains the previous DMA path; no inference kernels change.
 inline bool dense_upload_kernel_enabled() {
     const char* e = std::getenv("STRATA_DENSE_UPLOAD_KERNEL"); return e && e[0] == '1';
 }
+inline void dense_mismatch_probe(sycl::queue& q, const void* target, const void* input, size_t offset) {
+    if (sycl::get_pointer_type(input, q.get_context()) != sycl::usm::alloc::host) return;
+    auto* d = sycl::malloc_device<uint8_t>(16, q);
+    auto* h = sycl::malloc_host<uint8_t>(16, q);
+    if (!d || !h) { if(d) sycl::free(d,q); if(h) sycl::free(h,q); return; }
+    const auto* src=(const uint8_t*)input; const auto* dst=(const uint8_t*)target;
+    q.single_task<class DenseUploadMismatchProbe>([=] {
+        for(int j=0;j<16;j+=2) { d[j]=src[offset]; d[j+1]=dst[offset]; }
+    }).wait();
+    q.memcpy(h,d,16).wait();
+    std::fprintf(stderr,"strata weight check: GPU-side (host-USM source/device destination) byte pairs:");
+    for(int j=0;j<16;j+=2) std::fprintf(stderr," %u/%u",h[j],h[j+1]);
+    std::fprintf(stderr,"\n");
+    sycl::free(d,q); sycl::free(h,q);
+}
 inline void dense_upload(sycl::queue& q, void* target, const void* input, size_t bytes) {
     if (!dense_upload_kernel_enabled() || sycl::get_pointer_type(input, q.get_context()) != sycl::usm::alloc::host) {
         q.memcpy(target, input, bytes).wait(); return;
