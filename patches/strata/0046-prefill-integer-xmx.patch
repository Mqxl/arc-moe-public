From df8282b726d02c14d82def63aa21bdb84028f830 Mon Sep 17 00:00:00 2001
From: arc-moe <arc-moe@localhost>
Date: Thu, 8 Oct 2026 22:28:44 +0500
Subject: [PATCH] sycl: opt-in exact-code SG8 integer XMX prefill experts

---
 sycl/src/kernels/cuda/iq_kernels.dp.cpp | 135 +++++++++++++++++++++++-
 1 file changed, 133 insertions(+), 2 deletions(-)

diff --git a/sycl/src/kernels/cuda/iq_kernels.dp.cpp b/sycl/src/kernels/cuda/iq_kernels.dp.cpp
index d96b2c4..cfae2f5 100644
--- a/sycl/src/kernels/cuda/iq_kernels.dp.cpp
+++ b/sycl/src/kernels/cuda/iq_kernels.dp.cpp
@@ -2694,6 +2694,129 @@ void launch_pf_xmx(unsigned groups, dpct::queue_ptr q, const unsigned long long*
     });
 }
 
+
+// IQ2_XXS gate/up and Q2_0 down on integer XMX. Keep q8_1 bytes, signed
+// grid codes and integer scale division; FP32 reduction order changes from DP4A.
+// An unsupported device or format keeps the existing prompt kernel.
+bool pf_i8_supported(const sycl::device& device) {
+    namespace jm = sycl::ext::oneapi::experimental::matrix;
+    static thread_local std::vector<std::pair<sycl::device, bool>> cached;
+    for (const auto& entry : cached) if (entry.first == device) return entry.second;
+    bool supported = false;
+    try {
+        const auto widths = device.get_info<sycl::info::device::sub_group_sizes>();
+        const bool sg8 = std::find(widths.begin(), widths.end(), 8) != widths.end();
+        for (const auto& c : device.get_info<sycl::ext::oneapi::experimental::info::device::matrix_combinations>()) {
+            auto fits = [](size_t size, size_t limit, size_t wanted) { return size == wanted || (!size && limit >= wanted); };
+            supported |= sg8 && c.atype == jm::matrix_type::sint8 && c.btype == jm::matrix_type::sint8 &&
+                         c.ctype == jm::matrix_type::sint32 && c.dtype == jm::matrix_type::sint32 &&
+                         fits(c.msize, c.max_msize, 8) && fits(c.nsize, c.max_nsize, 8) && fits(c.ksize, c.max_ksize, 32);
+        }
+    } catch (const sycl::exception&) { supported = false; }
+    std::fprintf(stderr, "strata prefill: integer XMX 8x8x32 %s on %s\n",
+                 supported ? "supported" : "unsupported; keeping DP4A",
+                 device.get_info<sycl::info::device::name>().c_str());
+    cached.emplace_back(device, supported);
+    return supported;
+}
+
+template <bool Down>
+void launch_pf_i8(unsigned groups, dpct::queue_ptr q, const unsigned long long* ptr,
+                        const int32_t* start, const int32_t* ng, const int32_t* dst,
+                        const block_q8_1* x, NativeExpertLayout L, float* out, float* up) {
+    constexpr int SG = 8, NSG = 8, WG = SG * NSG, NT = 8;
+    const int nin = Down ? L.n_ff : L.n_embd, nout = Down ? L.n_embd : 2 * L.n_ff;
+    q->submit([&](sycl::handler& h) {
+        sycl::local_accessor<int8_t, 1> bm(sycl::range<1>(NT * 32), h);
+        sycl::local_accessor<int, 1> factors(sycl::range<1>(NT), h);
+        sycl::local_accessor<float, 1> scales(sycl::range<1>(NT), h);
+        sycl::local_accessor<int8_t, 1> am(sycl::range<1>(NSG * 8 * 32), h);
+        sycl::local_accessor<int32_t, 1> cm(sycl::range<1>(NSG * 64), h);
+        h.parallel_for<dpct_kernel_name<class pf_i8_acm, dpct_kernel_scalar<Down>>>(
+            sycl::nd_range<3>(sycl::range<3>(1, groups, (size_t)((nout + NT - 1) / NT) * WG),
+                              sycl::range<3>(1, 1, WG)),
+            [=](sycl::nd_item<3> it) [[sycl::reqd_sub_group_size(8)]] {
+#pragma clang fp contract(off)
+                namespace jm = sycl::ext::oneapi::experimental::matrix;
+                const int g = it.get_group(1);
+                if (g >= *ng) return;
+                const int tid = it.get_local_id(2), sgid = tid / SG, lane = tid % SG;
+                const int f0 = it.get_group(2) * NT, e0 = start[g], e1 = start[g + 1];
+                auto sg = it.get_sub_group();
+                auto lp = [](auto* p) { return sycl::address_space_cast<sycl::access::address_space::local_space,
+                                                sycl::access::decorated::no>(p); };
+                auto* b = bm.template get_multi_ptr<sycl::access::decorated::no>().get();
+                auto* ls = factors.template get_multi_ptr<sycl::access::decorated::no>().get();
+                auto* d = scales.template get_multi_ptr<sycl::access::decorated::no>().get();
+                auto* a = am.template get_multi_ptr<sycl::access::decorated::no>().get() + sgid * 256;
+                auto* c = cm.template get_multi_ptr<sycl::access::decorated::no>().get() + sgid * 64;
+                for (int eb = e0; eb < e1; eb += NSG * 8) {
+                    const int em = eb + sgid * 8;
+                    float sum[8] = {};
+                    for (int k0 = 0; k0 < nin; k0 += 32) {
+                        it.barrier(sycl::access::fence_space::local_space);
+                        if constexpr (Down) {
+                            for (int i = tid; i < NT * 32; i += WG) {
+                                const int n = i % NT, k = i / NT, r = f0 + n, j = (k0 + k) % 64;
+                                int value = 0;
+                                if (r < nout) {
+                                    const auto* w = (const block_q2_0*)((const uint8_t*)ptr[g] + L.down_off + (size_t)r * L.d_row);
+                                    value = ((w[k0 / 64].qs[j / 4] >> (2 * (j % 4))) & 3) - 1;
+                                }
+                                b[(k / 4) * (NT * 4) + n * 4 + k % 4] = (int8_t)value;
+                            }
+                            if (tid < NT) {
+                                const int r = f0 + tid;
+                                d[tid] = r < nout ? (float)((const block_q2_0*)((const uint8_t*)ptr[g] + L.down_off + (size_t)r * L.d_row))[k0 / 64].d : 0.f;
+                            }
+                        } else if (tid < NT) {
+                            const int r = f0 + tid;
+                            Split<16>::W w{};
+                            if (r < nout) {
+                                const int row = r >= L.n_ff ? r - L.n_ff : r;
+                                const size_t off = r >= L.n_ff ? L.up_off : 0;
+                                w = Split<16>::load((const uint8_t*)ptr[g] + off + (size_t)row * L.gu_row,
+                                                    k0 / 256, 2 * ((k0 % 256) / 32));
+                            }
+                            for (int j = 0; j < 32; ++j)
+                                b[(j / 4) * (NT * 4) + tid * 4 + j % 4] = (int8_t)((uint32_t)w.g[j / 4] >> (8 * (j % 4)));
+                            d[tid] = w.dw; ls[tid] = w.ls;
+                        }
+                        for (int i = lane; i < 256; i += SG) {
+                            const int e = em + i / 32;
+                            a[i] = e < e1 ? x[(size_t)(Down ? e : dst[e]) * (nin / 32) + k0 / 32].qs[i % 32] : 0;
+                        }
+                        it.barrier(sycl::access::fence_space::local_space);
+                        jm::joint_matrix<sycl::sub_group, int8_t, jm::use::a, 8, 32, jm::layout::row_major> A;
+                        jm::joint_matrix<sycl::sub_group, int8_t, jm::use::b, 32, 8, jm::layout::ext_intel_packed> B;
+                        jm::joint_matrix<sycl::sub_group, int32_t, jm::use::accumulator, 8, 8> C;
+                        jm::joint_matrix_fill(sg, C, 0);
+                        jm::joint_matrix_load(sg, A, lp(a), 32);
+                        jm::joint_matrix_load(sg, B, lp(b), NT * 4);
+                        jm::joint_matrix_mad(sg, C, A, B, C);
+                        jm::joint_matrix_store(sg, C, lp(c), 8, jm::layout::row_major);
+                        sycl::group_barrier(sg);
+                        for (int t = 0; t < 8; ++t) {
+                            const int e = em + t;
+                            if (e < e1) {
+                                // Preserve IQ2_XXS integer scaling/truncation before conversion to FP32.
+                                const int dot = Down ? c[t * 8 + lane] : c[t * 8 + lane] * ls[lane] / 8;
+                                sum[t] += (d[lane] * (float)x[(size_t)(Down ? e : dst[e]) * (nin / 32) + k0 / 32].ds[0]) * dot;
+                            }
+                        }
+                    }
+                    for (int t = 0; t < 8; ++t) {
+                        const int e = em + t, r = f0 + lane;
+                        if (e < e1 && r < nout) {
+                            if constexpr (Down) out[(size_t)dst[e] * nout + r] = sum[t];
+                            else (r >= L.n_ff ? up : out)[(size_t)e * L.n_ff + (r >= L.n_ff ? r - L.n_ff : r)] = sum[t];
+                        }
+                    }
+                }
+            });
+    });
+}
+
 // Prompt-only full expert fusion: gate/up, SwiGLU/q8_1 and down in one work-group.
 // Hidden activations stay in local memory. The original three kernels remain the default.
 template <int TG, int NC>
@@ -2827,7 +2950,11 @@ static void native_expert_grouped_impl(const NativeExpertLayout& L, const unsign
     const int64_t gy = (v1 || grid_groups <= 0 || grid_groups > cap_groups) ? cap_groups : grid_groups;
     const dpct::dim3 ggu((unsigned)((2 * L.n_ff + kExpertRows - 1) / kExpertRows),
                          (unsigned)gy);
-    if (use_xmx) {
+    static const bool pf_i8_gu = env_on("STRATA_PF_GU_I8_XMX");
+    if (prefill && !v1 && pf_i8_gu && L.gu_type == 16 && L.n_embd % 256 == 0 &&
+        cap_groups > 0 && cap_entries >= cap_groups * xmx_min_rows && pf_i8_supported(s->get_device())) {
+        launch_pf_i8<false>(gy, s, grp_ptr, grp_start, n_groups, ent_tok, X, L, gate, up);
+    } else if (use_xmx) {
         if (xmx_grf128) launch_pf_xmx<false, 128>(gy, s, grp_ptr, grp_start, n_groups, ent_tok, X, L, gate, up);
         else launch_pf_xmx<false, 256>(gy, s, grp_ptr, grp_start, n_groups, ent_tok, X, L, gate, up);
     }
@@ -2898,7 +3025,11 @@ static void native_expert_grouped_impl(const NativeExpertLayout& L, const unsign
     }
     check("native_expert_grouped/swiglu");
     const dpct::dim3 gd((unsigned)((L.n_embd + kExpertRows - 1) / kExpertRows), (unsigned)gy);
-    if (use_xmx) {
+    static const bool pf_i8 = env_on("STRATA_PF_DOWN_I8_XMX");
+    if (prefill && !v1 && pf_i8 && L.d_type == 42 && L.n_ff % 64 == 0 &&
+        cap_groups > 0 && cap_entries >= cap_groups * xmx_min_rows && pf_i8_supported(s->get_device())) {
+        launch_pf_i8<true>(gy, s, grp_ptr, grp_start, n_groups, ent_dst, hq, L, out, nullptr);
+    } else if (use_xmx) {
         if (xmx_grf128) launch_pf_xmx<true, 128>(gy, s, grp_ptr, grp_start, n_groups, ent_dst, hq, L, out, nullptr);
         else launch_pf_xmx<true, 256>(gy, s, grp_ptr, grp_start, n_groups, ent_dst, hq, L, out, nullptr);
     }
