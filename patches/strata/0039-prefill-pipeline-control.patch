From 92d06d75212aef337eea4f18627de598dccdce2e Mon Sep 17 00:00:00 2001
From: arc-moe <arc-moe@localhost>
Date: Thu, 8 Oct 2026 17:23:24 +0500
Subject: [PATCH] sycl: expose the existing prompt stage pipeline for serial
 A/B validation

---
 sycl/src/prefill/prefill.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/sycl/src/prefill/prefill.cpp b/sycl/src/prefill/prefill.cpp
index 4c5dc41..03967d3 100644
--- a/sycl/src/prefill/prefill.cpp
+++ b/sycl/src/prefill/prefill.cpp
@@ -1732,6 +1732,9 @@ bool Prefill::run(const int64_t *tokens, int64_t n, int64_t pos0,
     std::string next_err;
     std::future<bool> next_run;
     int hand_buf = 0;
+    const char* pipe_env = std::getenv("STRATA_PF_PIPELINE");
+    const bool pipeline = !pipe_env || pipe_env[0] != '0';  // preserve the existing two-stage pipeline
+
     double host_sync_ms = 0, host_chunk_ms = 0, host_setup_ms = 0;   // STRATA_PREFILL_TIMING: the host's share
     double grp_wait_ms = 0, grp_cpu_ms = 0;   // the per-layer grouping: the drain wait, the host's loops
     strata::kernels::QsaShapes s = strata::kernels::qsa_real_shapes();
@@ -3778,6 +3781,7 @@ bool Prefill::run(const int64_t *tokens, int64_t n, int64_t pos0,
                 return next_->run(tokens + c0, T, p0, next_err);
             });
             hand_buf ^= 1;
+            if (!pipeline && next_run.valid() && !next_run.get()) { err = next_err; return false; }
             continue;   // the last stage reports the chunk (on_chunk)
         }
         if (const char* dump = std::getenv("STRATA_PREFILL_DUMP_R")) {   // debug: the final residuals, every 64th
-- 
