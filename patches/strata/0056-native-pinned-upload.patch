From fc0e188d1ab756ac1bc05d819e2cbd001b834fc1 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 9 Oct 2026 12:19:56 +0500
Subject: [PATCH] native dense: opt-in bounded pinned uploads and readback
 diagnostics

---
 sycl/src/core/native_dense.cpp | 30 +++++++++++++++++++++++++-----
 1 file changed, 25 insertions(+), 5 deletions(-)

diff --git a/sycl/src/core/native_dense.cpp b/sycl/src/core/native_dense.cpp
index a0aaf25..dd41cb2 100644
--- a/sycl/src/core/native_dense.cpp
+++ b/sycl/src/core/native_dense.cpp
@@ -96,6 +96,12 @@ bool NativeDense::load(const std::vector<std::string> &shards,
     if (scratch_ || !weights_.empty()) { err = "native dense: already loaded"; return false; }
     if (shards.empty()) { err = "native dense: at least one GGUF shard is required"; return false; }
     try {
+        const char* pe = std::getenv("STRATA_NATIVE_UPLOAD_PINNED");
+        const bool pin_upload = pe && pe[0] == '1';
+        constexpr size_t upload_chunk = 8u << 20;
+        DevicePtr upload_stage(pin_upload ? sycl::malloc_host(upload_chunk, dpct::get_in_order_queue()) : nullptr);
+        if (pin_upload && !upload_stage) { err = "native dense: no pinned upload buffer"; return false; }
+        if (pin_upload) std::fprintf(stderr, "strata native dense: bounded pinned upload, 8 MiB staging\n");
         std::vector<Pending> pending;
         std::set<std::string> seen;
         int max_in = 0;
@@ -187,17 +193,31 @@ bool NativeDense::load(const std::vector<std::string> &shards,
                     DPCT_CHECK_ERROR(allocation = (void *)sycl::malloc_device(
                                          bytes, dpct::get_in_order_queue()));
                 DevicePtr data(allocation);
-                if (status == 0)
-                    status = DPCT_CHECK_ERROR(
-                        dpct::get_in_order_queue()
-                            .memcpy(data.get(), gguf.tensor_data(tensor), bytes)
-                            .wait());
+                if (status == 0 && pin_upload) {
+                    const auto* source = (const uint8_t*) gguf.tensor_data(tensor);
+                    for (size_t at = 0; at < bytes && status == 0; at += upload_chunk) {
+                        const size_t nb = std::min(upload_chunk, (size_t) bytes - at);
+                        std::memcpy(upload_stage.get(), source + at, nb);
+                        status = DPCT_CHECK_ERROR(dpct::get_in_order_queue().memcpy(
+                            (uint8_t*) data.get() + at, upload_stage.get(), nb).wait());
+                    }
+                } else if (status == 0)
+                    status = DPCT_CHECK_ERROR(dpct::get_in_order_queue()
+                        .memcpy(data.get(), gguf.tensor_data(tensor), bytes).wait());
                 if (const char* dbg = std::getenv("STRATA_DBG_WEIGHT_COPY"); status == 0 && dbg && dbg[0] == '1') {
                     std::vector<uint8_t> back((size_t) bytes);
                     dpct::get_in_order_queue().memcpy(back.data(), data.get(), bytes).wait();
                     const auto* expected = (const uint8_t*) gguf.tensor_data(tensor);
                     if (std::memcmp(back.data(), expected, (size_t) bytes)) {
                         size_t i = 0; while (i < bytes && back[i] == expected[i]) ++i;
+                        const size_t at = i & ~(size_t) 63, nb = std::min<size_t>(64, bytes - at);
+                        DevicePtr pinned_read(sycl::malloc_host(nb, dpct::get_in_order_queue()));
+                        if (pinned_read) for (int pass = 0; pass < 2; ++pass) {
+                            dpct::get_in_order_queue().memcpy(pinned_read.get(), (uint8_t*) data.get() + at, nb).wait();
+                            const auto* got = (const uint8_t*) pinned_read.get();
+                            std::fprintf(stderr, "strata weight check: pinned reread %d at byte %zu expected %u got %u window match %d\n",
+                                pass + 1, i, expected[i], got[i-at], (int) (std::memcmp(got, expected + at, nb) == 0));
+                        }
                         err = "native dense " + tensor.name + ": upload readback mismatch at tensor byte " + std::to_string(i);
                         std::fprintf(stderr, "strata weight check: %s expected %u got %u\n", err.c_str(), expected[i], back[i]);
                         return false;
