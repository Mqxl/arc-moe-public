From 1f10cb934b7c474108bc369be2b19e6890c840ba Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 9 Oct 2026 14:58:22 +0500
Subject: [PATCH] startup integrity: verify blocking expert uploads and final
 native snapshot

---
 sycl/src/core/expert_cache.cpp |  5 +++--
 sycl/src/core/native_dense.cpp | 25 +++++++++++++++++++++++--
 2 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/sycl/src/core/expert_cache.cpp b/sycl/src/core/expert_cache.cpp
index 40bb7d0..b79f767 100644
--- a/sycl/src/core/expert_cache.cpp
+++ b/sycl/src/core/expert_cache.cpp
@@ -5,6 +5,7 @@
 #include <sycl/sycl.hpp>
 #include <dpct/dpct.hpp>
 #include "strata/sycl_queue.hpp"
+#include "strata/sycl_dense_upload.hpp"
 #include "strata/core/expert_cache.hpp"
 
 #if !defined(STRATA_USE_HIP)
@@ -784,7 +785,7 @@ bool ExpertCache::fill_slot_blocking(int32_t slot, const uint8_t *host_blob,
     synchronization behavior.
     */
     const dpct::err0 e =
-        DPCT_CHECK_ERROR(dpct::get_in_order_queue().memcpy(dst, host_blob, n).wait());
+        DPCT_CHECK_ERROR(strata::dense_upload(dpct::get_in_order_queue(), dst, host_blob, n));
 #endif
     /*
     DPCT1000: Error handling if-stmt was detected but could not be
@@ -800,7 +801,7 @@ bool ExpertCache::fill_slot_blocking(int32_t slot, const uint8_t *host_blob,
         DPCT1001: The statement could not be removed.
         */
         err = std::string("ExpertCache::fill_slot_blocking: ") +
-              dpct::get_error_string_dummy(e);
+              (strata::dense_upload_bad_bytes ? "upload readback mismatch remains after bounded retries" : dpct::get_error_string_dummy(e));
         return false;
     }
     ++fills_;
diff --git a/sycl/src/core/native_dense.cpp b/sycl/src/core/native_dense.cpp
index b178c48..a45525a 100644
--- a/sycl/src/core/native_dense.cpp
+++ b/sycl/src/core/native_dense.cpp
@@ -48,6 +48,8 @@ struct Pending {
     WeightRef* ref;
     int type;
     uint64_t bytes;
+    std::string name;
+    const uint8_t* source;
     DevicePtr data;
 };
 }
@@ -109,6 +111,7 @@ bool NativeDense::load(const std::vector<std::string> &shards,
         std::vector<DevicePtr> quarantined;
         uint64_t quarantine_bytes = 0;
         constexpr uint64_t quarantine_limit = 128ull << 20;
+        std::vector<std::unique_ptr<strata::GgufFile>> held_inputs;
         std::vector<Pending> pending;
         std::set<std::string> seen;
         int max_in = 0;
@@ -117,7 +120,8 @@ bool NativeDense::load(const std::vector<std::string> &shards,
         std::set<uint64_t> split_numbers;
         bool have_architecture = false;
         for (const auto& path : shards) {
-            strata::GgufFile gguf(path);
+            held_inputs.push_back(std::make_unique<strata::GgufFile>(path));
+            auto& gguf = *held_inputs.back();
             const auto* count = gguf.get("split.count");
             const auto* number = gguf.get("split.no");
             const auto* tensors = gguf.get("split.tensors.count");
@@ -276,10 +280,27 @@ bool NativeDense::load(const std::vector<std::string> &shards,
                 }
                 max_in = (std::max)(max_in, (int) ref.ne0);
                 total += bytes;
-                pending.push_back(Pending{&ref, (int) tensor.type, bytes, std::move(data)});
+                pending.push_back(Pending{&ref, (int) tensor.type, bytes, tensor.name, (const uint8_t*)gguf.tensor_data(tensor), std::move(data)});
             }
         }
         if (pending.empty()) { err = "native dense: no supported GDN/QSA matrices in supplied shards"; return false; }
+        if (verify_env && verify_env[0]=='1') {
+            DevicePtr readback(sycl::malloc_host(upload_chunk, dpct::get_in_order_queue()));
+            if (!readback) { err="native dense snapshot: no readback buffer"; return false; }
+            for (const auto& item : pending) for (size_t at=0; at<item.bytes; at+=upload_chunk) {
+                const size_t n=std::min<size_t>(upload_chunk,item.bytes-at);
+                dpct::get_in_order_queue().memcpy(readback.get(),(const uint8_t*)item.data.get()+at,n).wait_and_throw();
+                const auto* got=(const uint8_t*)readback.get();
+                if (std::memcmp(got,item.source+at,n)) {
+                    size_t first=0; while(first<n && got[first]==item.source[at+first]) ++first;
+                    err="native dense final snapshot: "+item.name+" mismatch at byte "+std::to_string(at+first);
+                    std::fprintf(stderr,"strata upload verification: %s expected %u got %u\n",err.c_str(),item.source[at+first],got[first]);
+                    return false;
+                }
+            }
+            std::fprintf(stderr,"strata upload verification: final snapshot of all %zu native tensors passed\n",pending.size());
+        }
+
         void* allocation = nullptr;
         const auto status =
             DPCT_CHECK_ERROR(allocation = (void *)sycl::malloc_device(
-- 
