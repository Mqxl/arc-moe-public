diff --git a/sycl/CMakeLists.txt b/sycl/CMakeLists.txt
index a49a50d..3c00736 100644
--- a/sycl/CMakeLists.txt
+++ b/sycl/CMakeLists.txt
@@ -34,6 +34,16 @@ if(STRATA_SYCL_NO_FP64)
 endif()
 # The opt-in XMX kernels (qsa_prompt_attn_xmx, xmx_gemm_iq) use 16x16x16 FP16 joint_matrix tiles, Xe2's shape;
 # Alchemist's DPAS is 8x8x16 and IGC crashes on them for acm-g10. Off by default on Alchemist (the callers fall back).
+# dpct marked every kernel launch with use_root_sync, so DPC++ submits each one as a cooperative kernel
+# (zeCommandListAppendLaunchCooperativeKernel). No kernel here uses a root-group barrier, so the property only buys
+# the cooperative path's limits - on Arc A-series (i915) the first kernel on the second GPU of a layer split
+# (gather_rows, 384 x 256) fails with UR_RESULT_ERROR_OUT_OF_HOST_MEMORY. Off by default on Alchemist.
+option(STRATA_SYCL_NO_ROOT_SYNC "Launch kernels as ordinary (not cooperative) kernels" ${_strata_alchemist})
+if(STRATA_SYCL_NO_ROOT_SYNC)
+  add_compile_definitions(STRATA_ROOT_SYNC_PROP=)
+else()
+  add_compile_definitions(STRATA_ROOT_SYNC_PROP=sycl::ext::oneapi::experimental::use_root_sync)
+endif()
 option(STRATA_SYCL_NO_XMX "Leave out the joint_matrix kernels (required on Arc A-series / Alchemist)" ${_strata_alchemist})
 if(STRATA_SYCL_NO_XMX)
   add_compile_definitions(STRATA_SYCL_NO_XMX=1)
