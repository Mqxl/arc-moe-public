 sycl/src/kernels/cuda/sampler.dp.cpp       | 45 ++++++++---------
 sycl/src/kernels/cuda/shared_expert.dp.cpp | 23 ++++-----
 11 files changed, 158 insertions(+), 104 deletions(-)
 create mode 100644 sycl/include/strata/sycl_fp.hpp

diff --git a/sycl/CMakeLists.txt b/sycl/CMakeLists.txt
index 1b6094a..b5b2879 100644
--- a/sycl/CMakeLists.txt
+++ b/sycl/CMakeLists.txt
@@ -21,12 +21,30 @@ endif()
 add_compile_definitions(STRATA_VERSION="${PROJECT_VERSION}-sycl")
 
 set(STRATA_SYCL_AOT "" CACHE STRING "AOT device for the GPU code, e.g. bmg-g31 (empty: SPIR-V, JIT at run time)")
+# arc-moe: Alchemist (Xe-HPG: acm-g10 = A770/A750, acm-g11 = A380, acm-g12 = A580, "dg2") has no FP64 unit.
+# STRATA_SYCL_NO_FP64 turns the device reductions upstream writes in double into float (strata/sycl_fp.hpp);
+# it is on by default whenever the AOT target is an Alchemist part.
+set(_strata_alchemist OFF)
+if(STRATA_SYCL_AOT MATCHES "(^|,)(acm|dg2)")
+  set(_strata_alchemist ON)
+endif()
+option(STRATA_SYCL_NO_FP64 "Device code without FP64 (required on Arc A-series / Alchemist)" ${_strata_alchemist})
+if(STRATA_SYCL_NO_FP64)
+  add_compile_definitions(STRATA_SYCL_NO_FP64=1)
+endif()
+# The expert cache is ONE device allocation of 10-15 GB. IGC may otherwise assume every buffer is below 4 GB and
+# address it with 32-bit offsets; this option makes it keep 64-bit (stateless) addressing for every kernel.
+set(_strata_igc_opts "-cl-fp32-correctly-rounded-divide-sqrt -ze-opt-greater-than-4GB-buffer-required")
+set(STRATA_SYCL_IGC_EXTRA "" CACHE STRING "Extra IGC options for the device code (e.g. -ze-opt-large-register-file)")
+if(STRATA_SYCL_IGC_EXTRA)
+  string(APPEND _strata_igc_opts " ${STRATA_SYCL_IGC_EXTRA}")
+endif()
 set(_sycl_flags -fsycl)
 if(STRATA_SYCL_AOT)
   list(APPEND _sycl_flags -fsycl-targets=spir64_gen)
   # the divide/sqrt rounding option (below) must reach ocloc here: an AOT build has no spir64 backend to take it
   set(_sycl_link -fsycl -fsycl-targets=spir64_gen -Xsycl-target-backend=spir64_gen
-      "-device ${STRATA_SYCL_AOT} -options -cl-fp32-correctly-rounded-divide-sqrt")
+      "-device ${STRATA_SYCL_AOT} -options \"${_strata_igc_opts}\"")
 else()
   set(_sycl_link -fsycl)
 endif()
@@ -36,7 +54,7 @@ endif()
 # SYCL_PROGRAM_COMPILE_OPTIONS=-cl-fp32-correctly-rounded-divide-sqrt at run time.) The AOT build passes it to
 # ocloc above; without that the 303k mismatches came back on 2026-09-30, unnoticed since the AOT switch.
 if(NOT STRATA_SYCL_AOT)
-  list(APPEND _sycl_link "-Xsycl-target-backend=spir64" "-cl-fp32-correctly-rounded-divide-sqrt")
+  list(APPEND _sycl_link "-Xsycl-target-backend=spir64" "${_strata_igc_opts}")
 endif()
