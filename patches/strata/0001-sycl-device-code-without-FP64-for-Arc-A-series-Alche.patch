diff --git a/sycl/include/strata/sycl_fp.hpp b/sycl/include/strata/sycl_fp.hpp
new file mode 100644
index 0000000..52c6151
--- /dev/null
+++ b/sycl/include/strata/sycl_fp.hpp
@@ -0,0 +1,27 @@
+// include/strata/sycl_fp.hpp - the SYCL port's precision switch for GPUs without FP64 (arc-moe).
+//
+// Upstream accumulates a handful of device reductions in `double` (the router's softmax sum, the RMS norms of the
+// GDN and QSA paths, the shared expert's scalar gate, the sampler's nucleus). Battlemage (Xe2) executes FP64 in
+// hardware, so the port kept it. Alchemist (Xe-HPG, the Arc A770 / A750 / A580 / A380) has NO FP64 unit at all:
+// an AOT build for acm-g10 stops with "Double type is not supported on this platform", and a JIT build either
+// fails at the first launch of such a kernel or, with the driver's software emulation forced on, spends tens of
+// microseconds per call in it.
+//
+// `sfp_t` is that accumulator. With STRATA_SYCL_NO_FP64 (set by -DSTRATA_SYCL_NO_FP64=ON, the default for an
+// acm-g10 build) it is `float`, which is what llama.cpp's SYCL backend uses for the same reductions; otherwise it
+// is `double` and the kernels are exactly upstream's. Every partial sum in these kernels is already a tree (or
+// at most 512 terms of magnitude <= 1), so float keeps the result within a few ulp of the float output it is
+// rounded to anyway.
+#pragma once
+
+namespace strata {
+#if defined(STRATA_SYCL_NO_FP64)
+using sfp_t = float;
+inline constexpr bool kDeviceFp64 = false;
+#else
+using sfp_t = double;
+inline constexpr bool kDeviceFp64 = true;
+#endif
+}  // namespace strata
+
+using strata::sfp_t;
