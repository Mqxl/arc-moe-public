+#!/usr/bin/env bash
+# strata-sycl-native.sh (arc-moe): the SYCL engine as serve/server.py's `exe`, run on the host - no Docker.
+# The serve protocol is lines on stdin/stdout; stderr goes to the server's log. The config's "env" carries the
+# Arc switches (sycl/setup_intel.py: arc_env); this only makes the oneAPI runtime findable and execs the binary.
+#   STRATA_SYCL_BIN   the engine binary (default: build-sycl-aot/strata in this checkout)
+#   ONEAPI_ROOT       where oneAPI is installed (default: /opt/intel/oneapi)
+here=$(cd "$(dirname "$0")/../.." && pwd)
+bin=${STRATA_SYCL_BIN:-$here/build-sycl-aot/strata}
+case "$bin" in /*) ;; *) bin=$here/$bin ;; esac
+if [ -z "${SETVARS_COMPLETED:-}" ]; then
+    # setvars.sh trips over `set -u` (OCL_ICD_FILENAMES: unbound variable, oneAPI 2026.1): source it before any set -u
+    # shellcheck disable=SC1091
+    . "${ONEAPI_ROOT:-/opt/intel/oneapi}/setvars.sh" --force >/dev/null 2>&1 || {
+        echo "strata-sycl-native: cannot source ${ONEAPI_ROOT:-/opt/intel/oneapi}/setvars.sh" >&2; exit 127; }
+fi
+set -euo pipefail
+if [ "${ONEAPI_DEVICE_SELECTOR:-}" = arc ]; then
+    # the discrete Arcs only, as Level Zero numbers them: an Intel CPU's integrated GPU (UHD, or an integrated
+    # "Arc(TM) Graphics") would otherwise be level_zero:0 and take a card's place in the layer split
+    unset ONEAPI_DEVICE_SELECTOR
+    ids=$(sycl-ls 2>/dev/null | sed -nE 's/^\[level_zero:gpu\]\[level_zero:([0-9]+)\].*Arc\(TM\) (Pro )?[AB][0-9]{2,3}.*/\1/p' | paste -sd, -)
+    if [ -n "$ids" ]; then export ONEAPI_DEVICE_SELECTOR="level_zero:$ids"; fi
+    echo "strata-sycl-native: discrete Arc GPUs: ${ONEAPI_DEVICE_SELECTOR:-none found, all devices visible}" >&2
+fi
+: "${SYCL_CACHE_PERSISTENT:=0}" "${ZES_ENABLE_SYSMAN:=1}" "${UR_L0_ENABLE_RELAXED_ALLOCATION_LIMITS:=1}"
+export SYCL_CACHE_PERSISTENT ZES_ENABLE_SYSMAN UR_L0_ENABLE_RELAXED_ALLOCATION_LIMITS
+[ -x "$bin" ] || { echo "strata-sycl-native: no engine at $bin (scripts/build.sh)" >&2; exit 127; }
+cd "$here"
+exec "$bin" "$@"
