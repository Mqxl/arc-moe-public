From 07fd0eb36d79f0faf5ea6be61a80197d8b514901 Mon Sep 17 00:00:00 2001
From: arc-moe <arc-moe@users.noreply.github.com>
Date: Wed, 7 Oct 2026 14:40:06 +0000
Subject: [PATCH] sycl: no fp64 capability check under STRATA_SYCL_NO_FP64
 (sampled requests failed on Alchemist)

dpct left a has_capability_or_fail(fp64) before every launch whose CUDA source used double. Under
STRATA_SYCL_NO_FP64 that arithmetic is float, but the check still threw on the A-series (no FP64): every
request with temperature > 0 - OpenRouter, OpenAI SDKs, agent harnesses - and the coupled MTP draft.
The verify window's head sampling now returns the error instead of throwing past the window, and the
server drops a repetition_penalty <= 0 (some clients' "off"), which divided the logits by zero.
---
 serve/server.py              | 3 ++-
 sycl/include/dpct/device.hpp | 7 +++++++
 sycl/src/core/verify.cpp     | 7 ++++++-
 3 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/serve/server.py b/serve/server.py
index bfc2a4f..fc0294d 100644
--- a/serve/server.py
+++ b/serve/server.py
@@ -668,7 +668,8 @@ class StrataEngine:
         if isinstance(mp, (int, float)) and 0.0 < float(mp) <= 1.0:
             keys += f" min_p={float(mp)!r}"
         rp = sampling.get("repetition_penalty")
-        rp_on = isinstance(rp, (int, float)) and float(rp) != 1.0
+        # 0 (or less) is some clients' "off": the engine divides positive logits by it (inf, then NaN on the head)
+        rp_on = isinstance(rp, (int, float)) and not isinstance(rp, bool) and float(rp) > 0.0 and float(rp) != 1.0
         pf = sampling.get("frequency_penalty")
         pf_on = isinstance(pf, (int, float)) and float(pf) != 0.0
         pp = sampling.get("presence_penalty")
diff --git a/sycl/include/dpct/device.hpp b/sycl/include/dpct/device.hpp
index eec8710..bc2d40c 100644
--- a/sycl/include/dpct/device.hpp
+++ b/sycl/include/dpct/device.hpp
@@ -429,6 +429,13 @@ has_capability_or_fail(const sycl::device &dev,
   for (const auto &it : props) {
     if (dev.has(it))
       continue;
+#if defined(STRATA_SYCL_NO_FP64)
+    // arc-moe: dpct put an fp64 check before every launch whose CUDA source had a double; under STRATA_SYCL_NO_FP64
+    // that arithmetic is float (strata/sycl_fp.hpp, ./arc check-fp64), so the check is stale - and on Alchemist,
+    // which has no FP64, it threw on the sampled path (temperature > 0: every OpenAI-style client) and the drafter.
+    if (it == sycl::aspect::fp64)
+      continue;
+#endif
     switch (it) {
     case sycl::aspect::fp64:
       throw std::runtime_error("'double' is not supported in '" +
diff --git a/sycl/src/core/verify.cpp b/sycl/src/core/verify.cpp
index 68eb6f4..b4fb49f 100644
--- a/sycl/src/core/verify.cpp
+++ b/sycl/src/core/verify.cpp
@@ -1638,7 +1638,12 @@ bool Verifier::run(int T, const int32_t *tokens, int64_t pos0, PoolMultiFn pool,
     if (head_sampling_ && (sampled || hist_d_ != nullptr)) {
         SamplerParams sp = sampling_;
         sp.counter = (uint64_t) pos0;
-        sample_tokens(head_logits_, T, (int) n_vocab_, hist_d_, hist_len_, sp, m_out_, cs_);
+        try {   // arc-moe: a failed launch is this request's error, not an exception past the window
+            sample_tokens(head_logits_, T, (int) n_vocab_, hist_d_, hist_len_, sp, m_out_, cs_);
+        } catch (const std::exception& e) {
+            err = std::string("verify: the head sampling failed: ") + e.what();
+            return false;
+        }
         if (DPCT_CHECK_ERROR(cs_->wait()) !=
             0) { // m_out_ is the mapped h_out_: synced, it is readable
             err = "verify: the head sampling failed";
-- 
