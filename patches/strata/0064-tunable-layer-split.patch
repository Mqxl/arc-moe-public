From be502b60efdcea2fcdb72aaa021799d3f74e53c3 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 9 Oct 2026 18:13:48 +0500
Subject: [PATCH] sycl: expose an optional layer split override for machine
 tuning

---
 sycl/serve/strata-sycl-native.sh | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/sycl/serve/strata-sycl-native.sh b/sycl/serve/strata-sycl-native.sh
index 17598f1..7725274 100755
--- a/sycl/serve/strata-sycl-native.sh
+++ b/sycl/serve/strata-sycl-native.sh
@@ -65,6 +65,13 @@ if [ -n "${STRATA_EXTRA_ARGS:-}" ]; then
     args+=("${extra[@]}")
     echo "strata-sycl-native: extra engine flags: ${extra[*]}" >&2
 fi
+# Portable tuning override; unset/empty retains the model's existing split policy.
+# A single visible device ignores it. It is appended after other engine defaults
+# so a saved STRATA_LAYER_SPLIT can steer this machine without editing the model.
+if [ "$n_visible" -ge 2 ] && [ -n "${STRATA_LAYER_SPLIT:-}" ]; then
+    args+=(--layer-split "$STRATA_LAYER_SPLIT")
+    echo "strata-sycl-native: layer split override: $STRATA_LAYER_SPLIT" >&2
+fi
 set -- "${args[@]}"
 cd "$here"
 # arc-moe: STRATA_WRAP runs the engine under a tool (./arc profile: unitrace for per-kernel GPU time)
-- 
2.43.0

