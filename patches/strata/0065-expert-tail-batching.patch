From: Codex <codex@openai.com>
Date: Fri, 9 Oct 2026 18:44:45 +0500
Subject: [PATCH] sycl: optional eight-entry expert tails with numerical and
 placement probe

---
 sycl/src/kernels/cuda/iq_kernels.dp.cpp   | 80 +++++++++++++++++++----
 sycl/src/kernels/native_expert_parity.cpp | 45 ++++++++++++-
 2 files changed, 111 insertions(+), 14 deletions(-)

diff --git a/sycl/src/kernels/cuda/iq_kernels.dp.cpp b/sycl/src/kernels/cuda/iq_kernels.dp.cpp
index 1d846b9..82c1fd2 100644
--- a/sycl/src/kernels/cuda/iq_kernels.dp.cpp
+++ b/sycl/src/kernels/cuda/iq_kernels.dp.cpp
@@ -1337,7 +1337,7 @@ __dpct_inline__ void row_dot_multi(const uint8_t* row, const block_q8_1* const*
 }
 
 // The entries e0..e1 of one row: chunks of 4 through the multi-entry dot, the rest one at a time.
-template <int TY, int LANES, int E = 4>
+template <int TY, int LANES, int E = 4, bool PACK_TAIL = false>
 __dpct_inline__ void row_entries(const uint8_t* wr, const block_q8_1* x, int x_stride, const int32_t* ent_idx,
                                  int e0, int e1, int nb, int sub, float* dst, size_t dst_stride,
                                  const void* grid = nullptr) {
@@ -1357,6 +1357,20 @@ __dpct_inline__ void row_entries(const uint8_t* wr, const block_q8_1* x, int x_s
                     for (int i = 0; i < E; ++i) dst[(size_t) (e + i) * dst_stride] = o[i];
             }
         }
+        if constexpr (PACK_TAIL && E == 8) {
+            const int left = e1 - e;
+            // Clamp only the padded inputs; never read a nonexistent entry or
+            // store a padded output. Each valid row retains its dot order.
+            if (left >= 5) {
+                const block_q8_1* xs[8];
+                for (int i = 0; i < 8; ++i) xs[i] = x + (size_t) ent_idx[e + sycl::min(i, left - 1)] * x_stride;
+                float o[8];
+                row_dot_multi<TY, LANES, 8>(wr, xs, nb, sub, o, grid);
+                if (sub == 0)
+                    for (int i = 0; i < left; ++i) dst[(size_t) (e + i) * dst_stride] = o[i];
+                e = e1;
+            }
+        }
         for (; e + 4 <= e1; e += 4) {
             const block_q8_1* xs[4] = {x + (size_t) ent_idx[e] * x_stride, x + (size_t) ent_idx[e + 1] * x_stride,
                                        x + (size_t) ent_idx[e + 2] * x_stride, x + (size_t) ent_idx[e + 3] * x_stride};
@@ -1366,6 +1380,17 @@ __dpct_inline__ void row_entries(const uint8_t* wr, const block_q8_1* x, int x_s
 #pragma unroll
                 for (int i = 0; i < 4; ++i) dst[(size_t) (e + i) * dst_stride] = o[i];
         }
+        if constexpr (PACK_TAIL) {
+            if (e1 - e == 3) {
+                const block_q8_1* xs[4];
+                for (int i = 0; i < 4; ++i) xs[i] = x + (size_t) ent_idx[e + sycl::min(i, 2)] * x_stride;
+                float o[4];
+                row_dot_multi<TY, LANES, 4>(wr, xs, nb, sub, o, grid);
+                if (sub == 0)
+                    for (int i = 0; i < 3; ++i) dst[(size_t) (e + i) * dst_stride] = o[i];
+                e = e1;
+            }
+        }
         if (e + 2 <= e1) {
             const block_q8_1* xs[2] = {x + (size_t) ent_idx[e] * x_stride, x + (size_t) ent_idx[e + 1] * x_stride};
             float o[2];
@@ -1382,7 +1407,7 @@ __dpct_inline__ void row_entries(const uint8_t* wr, const block_q8_1* x, int x_s
 
 constexpr int GU_ROWS = 8;     // rows per block (one warp each)
 
-template <int TG, int LN = kExpertLanes, int E = 4>
+template <int TG, int LN = kExpertLanes, int E = 4, bool PACK_TAIL = false>
 __dpct_inline__ void native_gu_kernel(
     const unsigned long long *__restrict__ grp_ptr,
     const int32_t *__restrict__ grp_start, const int32_t *__restrict__ n_groups,
@@ -1419,7 +1444,7 @@ __dpct_inline__ void native_gu_kernel(
     for (int g = (int) item_ct1.get_group(1); g < ng; g += (int) item_ct1.get_group_range(1)) {
         const uint8_t* wr = (const uint8_t*) grp_ptr[g] + off;
         const int e0 = grp_start[g], e1 = grp_start[g + 1];
-        row_entries<TG, LN, E>(wr, xq, xb, ent_tok, e0, e1, nb, sub, (is_up ? up : gate) + r, (size_t) L.n_ff, grid);
+        row_entries<TG, LN, E, PACK_TAIL>(wr, xq, xb, ent_tok, e0, e1, nb, sub, (is_up ? up : gate) + r, (size_t) L.n_ff, grid);
     }
 }
 
@@ -1477,7 +1502,7 @@ __dpct_inline__ void swiglu_entries_kernel(const float *__restrict__ gate,
     h[i] = (g / (1.0f + sycl::native::exp(-g))) * up[i];
 }
 
-template <int TD, int LN = kExpertLanes, int E = 4>
