-            native_gu_kernel<TG, LN, E>(grp_ptr, grp_start, n_groups, ent_tok, X, L, gate, up);
+            native_gu_kernel<TG, LN, E, PACK_TAIL>(grp_ptr, grp_start, n_groups, ent_tok, X, L, gate, up);
         });
 }
 template <int TG>
@@ -2248,17 +2296,17 @@ void launch_gu_lanes(dpct::dim3 grid, dpct::queue_ptr s, const unsigned long lon
