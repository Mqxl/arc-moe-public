         [=](sycl::nd_item<3>) [[sycl::reqd_sub_group_size(32)]] {
-            native_down_kernel<TD, LN, E>(grp_ptr, grp_start, n_groups, ent_dst, hq, L, out);
+            native_down_kernel<TD, LN, E, PACK_TAIL>(grp_ptr, grp_start, n_groups, ent_dst, hq, L, out);
         });
 }
 template <int TD>
@@ -3070,7 +3118,12 @@ static void native_expert_grouped_impl(const NativeExpertLayout& L, const unsign
     const dpct::dim3 ggu((unsigned)((2 * L.n_ff + kExpertRows - 1) / kExpertRows),
                          (unsigned)gy);
     static const bool pf_i8_gu = env_on("STRATA_PF_GU_I8_XMX");
-    if (prefill && !v1 && pf_i8_gu && L.gu_type == 16 && L.n_embd % 256 == 0 &&
+    static const int pack_tail = [] { const char* v = std::getenv("STRATA_EXPERT_TAIL_BATCH"); return v ? std::atoi(v) : 0; }();
+    const bool use_tail = !prefill && !v1 && (pack_tail == 1 || pack_tail == 2) && !g_old_kernels && !g_split_multi;
+    if (use_tail && L.gu_type == 22 && gu_lanes() == 32) {
+        if (pack_tail == 2) launch_gu_port<22, 32, 8, true>(gy, s, grp_ptr, grp_start, n_groups, ent_tok, X, L, gate, up);
+        else launch_gu_port<22, 32, 4, true>(gy, s, grp_ptr, grp_start, n_groups, ent_tok, X, L, gate, up);
+    } else if (prefill && !v1 && pf_i8_gu && L.gu_type == 16 && L.n_embd % 256 == 0 &&
         cap_groups > 0 && cap_entries >= cap_groups * xmx_min_rows && pf_i8_supported(s->get_device())) {
         dispatch_pf_i8<false>(gy, s, grp_ptr, grp_start, n_groups, ent_tok, X, L, gate, up);
     } else if (use_xmx) {
@@ -3147,7 +3200,10 @@ static void native_expert_grouped_impl(const NativeExpertLayout& L, const unsign
     check("native_expert_grouped/swiglu");
     const dpct::dim3 gd((unsigned)((L.n_embd + kExpertRows - 1) / kExpertRows), (unsigned)gy);
     static const bool pf_i8 = env_on("STRATA_PF_DOWN_I8_XMX");
-    if (prefill && !v1 && pf_i8 && L.d_type == 42 && L.n_ff % 64 == 0 &&
+    if (use_tail && L.d_type == 42 && down_lanes() == 8) {
+        if (pack_tail == 2) launch_down_port<42, 8, 8, true>(gy, s, grp_ptr, grp_start, n_groups, ent_dst, hq, L, out);
+        else launch_down_port<42, 8, 4, true>(gy, s, grp_ptr, grp_start, n_groups, ent_dst, hq, L, out);
+    } else if (prefill && !v1 && pf_i8 && L.d_type == 42 && L.n_ff % 64 == 0 &&
