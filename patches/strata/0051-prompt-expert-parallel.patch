+// Prompt-only expert parallelism. Decode keeps its original cache and layer split.
+// Peer weights are streamed into a bounded layer cache; no foreign USM pointer is
+// dereferenced by a kernel. All cross-device transfers pass through pinned host RAM.
+struct PromptEp {
+    static constexpr int B = 2048, G = 16;
+    int owner = -1, peer = -1;
+    double share = 0;
+    dpct::queue_ptr oq = nullptr, pq = nullptr, cq = nullptr, rq = nullptr;
+    uint8_t *hx = nullptr, *hw = nullptr, *xq = nullptr, *weights = nullptr, *table = nullptr;
+    float *hy = nullptr, *y = nullptr;
+    int32_t *map = nullptr, *ident = nullptr;
+    void* scratch = nullptr;
+    std::vector<void*> host_owned, device_owned;
+    std::vector<int32_t> rows;
+    std::vector<int32_t> count, offset;
+    std::vector<const uint8_t*> blobs;
+    std::vector<char> device_blob;
+    size_t slot_bytes = 0;
+    int64_t layers = 0, entries = 0;
+    double ms = 0;
+    ~PromptEp() {
+        if (oq) oq->wait();
+        if (pq) pq->wait();
+        if (cq) cq->wait();
+        if (rq) rq->wait();
+        if (pq) for (void* p : device_owned) sycl::free(p, *pq);
+        if (oq) for (void* p : host_owned) sycl::free(p, *oq);
+        const int prev = dpct::get_current_device_id();
+        if (pq) { dpct::select_device(peer); dpct::get_current_device().destroy_queue(pq); }
+        if (cq) { dpct::select_device(peer); dpct::get_current_device().destroy_queue(cq); }
+        if (rq) { dpct::select_device(peer); dpct::get_current_device().destroy_queue(rq); }
+        if (oq) { dpct::select_device(owner); dpct::get_current_device().destroy_queue(oq); }
+        dpct::select_device(prev);
+    }
+};
