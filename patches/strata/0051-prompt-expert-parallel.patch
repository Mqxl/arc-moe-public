+                            std::string ep_err;
+                            std::future<bool> ep_run;
+                            if (ep_layer && rows_peer) {
+                                PromptEp& P = *m.ep;
+                                P.rows.assign(src_h+rows_local, src_h+T*K);
+                                P.count.clear(); P.offset.clear(); P.blobs.clear(); P.device_blob.clear();
+                                for (int32_t e : order_peer) {
+                                    P.count.push_back(m.cnt[(size_t)e]);
+                                    P.offset.push_back(m.off[(size_t)e]-(int32_t)rows_local);
+                                    const bool pinned = source_pinned(l,e);
+                                    P.blobs.push_back(pinned ? source_blob(l,e) : m.cache->device_slot(m.host_res[(size_t)l*m.g->n_expert+e]));
+                                    P.device_blob.push_back(!pinned);
+                                    if (!P.blobs.back()) { err="prompt EP missing expert blob"; return false; }
+                                }
+                                const sycl::event ready = m.cs->ext_oneapi_submit_barrier();
+                                P.oq->ext_oneapi_submit_barrier({ready});
+                                auto input_ready = P.oq->memcpy(P.hx, xq, (size_t)T*(N/32)*36);
+                                ep_run = std::async(std::launch::async, [&, input_ready, NL, l, T, rows_local, blob]() mutable {
+                                    const core::OnDevice on(P.peer);
+                                    const auto start = Clock::now();
+                                    try {
+                                        input_ready.wait_and_throw();
+
+                                        P.cq->memcpy(P.xq, P.hx, (size_t)T*(N/32)*36);
+                                        auto maps_ready=P.cq->memcpy(P.map, P.rows.data(), P.rows.size()*4);
+                                        P.pq->ext_oneapi_submit_barrier({maps_ready});
+                                        size_t ei=0; int within=0; int32_t done=0, batch=0;
+                                        // Keep metadata addresses alive until the corresponding DMA completes.
+                                        std::vector<std::vector<uint8_t>> tables;
+                                        std::future<void> returned[2];
+                                        while (ei<P.count.size()) {
+                                            const int bank=batch++&1;
+                                            if (returned[bank].valid()) returned[bank].get();
+                                            tables.emplace_back(512,0);
+                                            uint8_t* ht=tables.back().data();
+                                            auto* hn=(int32_t*)ht; auto* hs=hn+4;
+                                            auto* hp=(unsigned long long*)(ht+256);
+                                            auto* weights=P.weights+(size_t)bank*PromptEp::G*P.slot_bytes;
+                                            auto* host_weights=P.hw+(size_t)bank*PromptEp::G*P.slot_bytes;
+                                            auto* table=P.table+bank*512;
+                                            auto* output=P.y+(size_t)bank*PromptEp::B*N;
+                                            auto* host_output=P.hy+(size_t)bank*PromptEp::B*N;
+                                            int nr=0, ng=0;
+                                            while (ei<P.count.size() && ng<PromptEp::G && nr<PromptEp::B) {
+                                                const int take=std::min(P.count[ei]-within, PromptEp::B-nr);
+                                                const uint8_t* host=P.blobs[ei];
+                                                if (P.device_blob[ei]) {
+                                                    auto* slot=host_weights+(size_t)ng*P.slot_bytes;
+                                                    P.oq->memcpy(slot, host, blob).wait_and_throw(); host=slot;
+                                                }
+                                                auto* dst=weights+(size_t)ng*P.slot_bytes;
+                                                P.cq->memcpy(dst, host, blob);
+                                                hs[ng]=nr; hp[ng]=(unsigned long long)dst;
+                                                nr+=take; ++ng; within+=take;
+                                                if (within==P.count[ei]) { ++ei; within=0; }
+                                            }
+                                            hn[0]=ng; hs[ng]=nr;
+                                            auto uploaded=P.cq->memcpy(table, ht, 512);
+                                            P.pq->ext_oneapi_submit_barrier({uploaded});
