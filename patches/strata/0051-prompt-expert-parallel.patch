+bool Prefill::set_prompt_ep(Prefill* partner, std::string& err) {
+    Impl& m = *impl_;
+    const char* enabled = std::getenv("STRATA_PF_EP");
+    if (!enabled || std::strcmp(enabled, "1") != 0 || !partner || partner == this) return true;
+    Impl& other = *partner->impl_;
+    if (m.device == other.device || m.device < 0 || other.device < 0) return true;
+    if (!pf_grouped_env() || !strata::kernels::cpu::expert_layout().native || mmq_plan().any) {
+        err = "prompt EP requires the grouped native path (MMQ/peer mode unsupported)"; return false;
+    }
+    const core::OnDevice restore(m.device);
+    auto ep = std::make_unique<PromptEp>();
+    ep->owner = m.device; ep->peer = other.device;
+    ep->slot_bytes = (size_t) MAXBLOB();
+    try {
+        ep->oq = dpct::get_current_device().create_queue(true);
+        auto host = [&](size_t n) {
+            void* p = sycl::malloc_host(n, *ep->oq);
+            if (!p) throw std::bad_alloc();
+            ep->host_owned.push_back(p); return p;
+        };
+        ep->hx = (uint8_t*) host((size_t)m.T_max * (N/32) * 36);
+        ep->hw = (uint8_t*) host(2 * PromptEp::G * ep->slot_bytes);
+        ep->hy = (float*) host(2 * PromptEp::B * N * 4);
+        dpct::select_device(ep->peer);
+        ep->pq = dpct::get_current_device().create_queue(true);
+        ep->cq = dpct::get_current_device().create_queue(true);
+        ep->rq = dpct::get_current_device().create_queue(true);
+        auto device = [&](size_t n) {
+            void* p = sycl::malloc_device(n, *ep->pq);
+            if (!p) throw std::bad_alloc();
+            ep->device_owned.push_back(p); return p;
+        };
+        ep->xq = (uint8_t*) device((size_t)m.T_max * (N/32) * 36);
+        ep->weights = (uint8_t*) device(2 * PromptEp::G * ep->slot_bytes);
+        ep->table = (uint8_t*) device(1024);
+        ep->map = (int32_t*) device((size_t)m.T_max * K * 4);
+        ep->ident = (int32_t*) device(PromptEp::B * 4);
+        ep->scratch = device(strata::kernels::native_expert_scratch_bytes(PromptEp::B, 640));
+        ep->y = (float*) device(2 * PromptEp::B * N * 4);
+        pfg_iota(ep->ident, PromptEp::B, ep->pq);
+        ep->pq->wait();
+        // Measure the real pinned-host link. Reuse the layer cache, with a warm-up
+        // excluded; explicit --pcie-frac must not make the EP ratio a guess.
+        auto probe = [&](dpct::queue_ptr q, void* dst) {
+            const size_t bytes = std::min<size_t>(8u<<20, PromptEp::G * ep->slot_bytes);
+            std::memset(ep->hw, 0, bytes);
+            q->memcpy(dst, ep->hw, bytes).wait();
+            const auto t = Clock::now();
+            for (int i=0; i<8; ++i) q->memcpy(dst, ep->hw, bytes);
+            q->wait(); return bytes * 8.0 / (ms_since(t) * 1e6);
+        };
+        const double peer_bw = probe(ep->pq, ep->weights);
+        dpct::select_device(m.device);
+        void* tmp = sycl::malloc_device(8u<<20, *ep->oq);
+        if (!tmp) throw std::bad_alloc();
+        double owner_bw = 0;
+        try { owner_bw = probe(ep->oq, tmp); }
+        catch (...) { sycl::free(tmp, *ep->oq); throw; }
+        sycl::free(tmp, *ep->oq);
+        ep->share = std::clamp(peer_bw / (owner_bw + peer_bw), 0.1, 0.65);
+        std::fprintf(stderr, "strata prompt EP: GPU%d -> GPU%d: owner %.2f peer %.2f GB/s, peer rows %.1f%%; "
+                             "bounded double-buffered %d-expert cache, FP32 result transport; existing stage pipeline retained\n",
+                     m.device, ep->peer, owner_bw, peer_bw, 100*ep->share, PromptEp::G);
+        m.ep = std::move(ep);
+        return true;
+    } catch (const std::exception& ex) {
+        err = std::string("prompt EP allocation/probe: ") + ex.what(); return false;
+    }
+}
