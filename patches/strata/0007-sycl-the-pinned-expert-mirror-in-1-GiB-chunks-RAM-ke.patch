+           "STRATA_MIRROR_RESERVE_MIB": "8192",          # RAM kept free after the pinned mirror (MTP, images, server)
            # "arc": strata-sycl-native.sh resolves it to the discrete Arcs (never the CPU's integrated GPU)
            "ONEAPI_DEVICE_SELECTOR": "arc"}
     if n_gpus > 1:
