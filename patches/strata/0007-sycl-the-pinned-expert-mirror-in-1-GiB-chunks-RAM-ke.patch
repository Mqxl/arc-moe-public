     int64_t n_layers_ = 0, n_expert_ = 0;
     int64_t reads_ = 0;
-    uint8_t* mirror_ = nullptr;                    ///< USM host (pinned, device-readable)
+    // arc-moe: the mirror is several USM host allocations of at most kMirrorChunk bytes, not one. A single
+    // malloc_host of 10+ GB is refused on Arc A-series (its max_mem_alloc_size is ~4 GB, and Level Zero's relaxed
+    // limits cover device and shared allocations only).
+    std::vector<uint8_t*> mirror_chunks_;          ///< USM host (pinned, device-readable)
     uint64_t mirror_bytes_ = 0;
-    std::vector<int64_t> mirror_off_;              ///< per (layer, expert): offset in mirror_, -1 = not mirrored
-    std::vector<int64_t> layer_first_;             ///< per layer: offset of its first mirrored blob, -1 = none
+    std::vector<uint8_t*> mirror_ptr_;             ///< per (layer, expert): its mirrored blob, nullptr = not mirrored
+    std::vector<uint8_t*> layer_first_;            ///< per layer: its first mirrored blob, nullptr = none
 };
 
 }  // namespace strata::core
diff --git a/sycl/setup_intel.py b/sycl/setup_intel.py
index 5c1919e..0e72d0e 100644
--- a/sycl/setup_intel.py
+++ b/sycl/setup_intel.py
@@ -149,6 +149,7 @@ def arc_env(cfg: dict, n_gpus: int) -> dict:
