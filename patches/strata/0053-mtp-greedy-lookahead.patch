                float* probs = nullptr, float min_p = 0.0f, int* n_drafts = nullptr);
 
+    /// Greedy lookahead continues the previous MTP chain, without reading window_R_.
+    /// Caller reuses it only after full target acceptance and an exact next-token match.
+    bool can_lookahead(int T) const {
+        return T>=2 && T<=8 && T==std::min(max_t_,max_drafts_+1) && !coupled_active_;
+    }
+    bool prepare_lookahead(int T, std::string& err);
+    bool lookahead(int T, int64_t pos, int32_t& anchor, int32_t* drafts, float* probs, std::string& err);
+    bool repair_window(int T, const int32_t* outputs, int64_t pos, std::string& err);
