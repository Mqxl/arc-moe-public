     return true;
 }
 
+
+bool MtpDrafter::prepare_lookahead(int T, std::string& err) {
+    const OnDevice on_device(device_);
+    if (!can_lookahead(T)) {
+        err="mtp lookahead: unsupported window or coupled sampler"; return false;
+    }
+    // Capture before starting the verifier thread/graph: the two extra steps
+    // use existing kernels and their own mapped step rows. No concurrent capture.
+    for (int j=1;j<=T;++j) if(!capture_step(j,false,err)) return false;
+    return true;
+}
+
+bool MtpDrafter::lookahead(int T, int64_t pos, int32_t& anchor, int32_t* drafts,
+                         float* probs, std::string& err) try {
+    const OnDevice on_device(device_);
+    if (!can_lookahead(T)) {
+        err="mtp lookahead: unsupported window or coupled sampler"; return false;
+    }
+    // The preceding chain left Rin_/tok_ at the last speculative input pair.
+    // One extra forward predicts the next target head; the rest proposes its
+    // following window. This approximate residual never enters target state.
+    for(int j=1;j<=T;++j) {
+        const int row=max_t_+j-1;
+        const int64_t cell=pos+T-3+j;
+        h_step_[row*4+0]=(int32_t)cell; h_step_[row*4+1]=(int32_t)(cell+1);
+        h_step_[row*4+2]=(int32_t)((cell+1)/4); h_step_[row*4+3]=(int32_t)(cell+1);
+        for(int64_t h=0;h<g_->n_head;++h) h_pos_[row*g_->n_head+h]=(int32_t)cell;
+    }
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    for(int j=1;j<=T;++j) cs_->ext_oneapi_graph(*step_exec_[j]);
+    cs_->wait_and_throw();
+    anchor=((volatile int32_t*)h_out_)[1];
+    for(int j=0;j<T-1;++j) {
+        drafts[j]=((volatile int32_t*)h_out_)[j+2];
+        probs[j]=((volatile float*)h_prob_)[j+2];
+    }
+    return true;
+} catch(const sycl::exception& e) { err=std::string("mtp lookahead: ")+e.what(); return false; }
+
+bool MtpDrafter::repair_window(int T,const int32_t* outputs,int64_t pos,std::string& err) {
+    // Recompute all committed MTP KV from the actual verifier residuals and
+    // tokens, not the approximate branch. Future cells are masked by position.
+    // The ring has window+4*max_t+64 slots, retaining the rollback read window.
+    return prefill(window_R_,outputs,T,pos,err);
+}
+
