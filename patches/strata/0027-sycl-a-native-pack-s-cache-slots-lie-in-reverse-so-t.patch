     } else if (base_ != nullptr) {
@@ -665,16 +671,43 @@ int32_t ExpertCache::admit(int64_t layer, int64_t expert) {
 
 uint8_t* ExpertCache::device_slot(int32_t slot) {
     if (slot < 0 || slot >= slots_) return nullptr;
+    if (!pos_.empty()) return base_ + pos_[(size_t) slot];
     if (!off_.empty()) return base_ + off_[(size_t) slot];
     return base_ + (size_t) slot * (size_t) blob_;
 }
 
 const uint8_t* ExpertCache::device_slot(int32_t slot) const {
     if (slot < 0 || slot >= slots_) return nullptr;
+    if (!pos_.empty()) return base_ + pos_[(size_t) slot];
     if (!off_.empty()) return base_ + off_[(size_t) slot];
     return base_ + (size_t) slot * (size_t) blob_;
 }
 
+// arc-moe: the slots in REVERSE address order - slot i ends where slot i - 1 starts, the last slot at the arena's start.
+// The prompt path borrows the last slots (the least-routed experts of the profile) for its buffers; on one 10-15 GB
+// arena they sat 7-11 GB in, and the oneMKL GEMMs of the prompt path (kernels this build does not compile, so
+// -ze-opt-greater-than-4GB-buffer-required does not reach them) returned garbage for operands past 4 GiB: every
+// batched prompt came out as NaN ("!!!!" - token 0) while the engine's own kernels read the same memory fine.
+// Laid out low, a loan of up to 4 GiB lies in the arena's first 4 GiB.  The order of the slots, the sizes and every
+// rule over slot indices are unchanged; only addresses move (device_slot, slot_offsets, device_base, lend_base).
+// STRATA_CACHE_TAIL_LOW=0: the old layout.  Not with --vram-elastic (shrink gives back the arena's END), and only for
+// sized slots (open_sized: the native packs) - the uniform-slot S2 kernels address `base + slot * blob` themselves.
+void ExpertCache::lay_out_tail_low() {
+    pos_.clear();
+    static const bool on = [] { const char* e = std::getenv("STRATA_CACHE_TAIL_LOW"); return !(e && e[0] == '0'); }();
+    if (!on || seg_req_ > 0 || !segs_.empty() || slots_ <= 1) return;
+    const uint64_t full = (uint64_t) full_bytes();
+    pos_.assign((size_t) slots_ + 1, 0);
+    for (int64_t i = 0; i < slots_; ++i) pos_[(size_t) i] = full - (uint64_t) slot_end(i + 1);
+    pos_[(size_t) slots_] = full;   // (one past the table, as off_: never a slot)
+}
+
+uint8_t* ExpertCache::lend_base(int32_t first) {
+    if (first < 0 || first >= live_slots_) return nullptr;
+    if (pos_.empty()) return device_slot(first);
+    return base_ + pos_[(size_t) (live_slots_ - 1)];   // the lowest of [first, live): the last live slot's start
+}
+
 bool ExpertCache::fill_slot(int32_t slot, const uint8_t *host_blob,
                             void *stream, std::string &err, int64_t bytes) try {
     const size_t n = (size_t) (bytes > 0 && bytes <= blob_ ? bytes : blob_);
