+    // arc-moe: the batched prompt's last residual row (40 KB, once per prompt) - a non-finite one is a request that
+    // would answer "!!!!" (token 0) to the end: refuse it with a reason instead (STRATA_PREFILL_NAN_CHECK=0: off)
+    static const bool nan_check = [] { const char* e = std::getenv("STRATA_PREFILL_NAN_CHECK"); return !(e && e[0] == '0'); }();
+    if (nan_check && n > 0) {
+        std::vector<float> row((size_t) D);
+        const int64_t last = (n - 1) % m.T;
+        try {
+            m.cs->memcpy(row.data(), m.R + last * D, (size_t) D * 4).wait();
+        } catch (const std::exception& e) {
+            err = std::string("prefill: reading the prompt's last row: ") + e.what();
+            return false;
+        }
+        int64_t badn = 0;
+        for (float v : row) badn += !std::isfinite(v);
+        if (badn > 0) {
+            static int said = 0;
+            if (said++ < 3)
+                std::fprintf(stderr, "strata prefill: ERROR: the batched prompt (%lld tokens, chunk %lld) left %lld of %lld "
+                                     "values of its last row non-finite - the reply would be garbage; refused. Restart "
+                                     "with --no-prefill-borrow, or STRATA_DBG_NAN=1 to see where it starts\n",
+                             (long long) n, (long long) m.T, (long long) badn, (long long) D);
+            err = "prefill: the prompt's hidden state is NaN (a GPU computation failed); see the engine log";
+            return false;
+        }
+    }
     if (DPCT_CHECK_ERROR(m.cs->wait()) != 0) {
         /*
         DPCT1009: SYCL reports errors using exceptions and does not use
