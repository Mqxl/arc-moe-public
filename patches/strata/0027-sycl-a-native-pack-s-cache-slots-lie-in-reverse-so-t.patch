 sycl/src/core/expert_cache.cpp       | 35 +++++++++++++++++++++++++++-
 sycl/src/prefill/prefill.cpp         | 25 ++++++++++++++++++++
 sycl/src/program/generate.cpp        | 30 ++++++++++++------------
 4 files changed, 90 insertions(+), 18 deletions(-)

diff --git a/include/strata/core/expert_cache.hpp b/include/strata/core/expert_cache.hpp
index 8c031ff..84af434 100644
--- a/include/strata/core/expert_cache.hpp
+++ b/include/strata/core/expert_cache.hpp
@@ -84,8 +84,19 @@ public:
     /// Plan v0.3 P6: slots of the given sizes, back to back (a native pack's blobs differ per layer, and a
     /// profile-filled tier never moves an expert to another layer's slot, so each slot keeps its first size).
     bool open_sized(const std::vector<int64_t>& slot_bytes, int64_t n_layers, int64_t n_expert, std::string& err);
-    /// Byte offset of each slot in the arena (null for uniform slots).
-    const uint64_t* slot_offsets() const { return off_.empty() ? nullptr : off_.data(); }
+    /// Byte offset of each slot in the arena (null for uniform slots) - where it IS: the device plan's pointers.
+    const uint64_t* slot_offsets() const { return !pos_.empty() ? pos_.data() : off_.empty() ? nullptr : off_.data(); }
+    /// Each slot's END in slot order (slots + 1 entries, null for uniform slots): sizes, not addresses - what the
+    /// prompt path's loan is priced with.  The same table as `slot_offsets()` unless the tail is laid out low.
+    const uint64_t* slot_ends() const { return off_.empty() ? nullptr : off_.data(); }
+    /// arc-moe: the arena's first byte (the device plan's base; `device_slot(0)` is not it when the tail is low).
+    uint8_t* device_base() const { return base_; }
+    /// arc-moe: the lowest address of the slots [first, slots()) - the prompt path's loan, contiguous either way.
+    uint8_t* lend_base(int32_t first);
+    /// arc-moe: true when the last slots sit at the START of the arena (STRATA_CACHE_TAIL_LOW, default on in this
+    /// port): the prompt path borrows the last slots, and its buffers then lie below 4 GiB of the allocation - where
+    /// the oneMKL GEMMs (which this build cannot compile with -ze-opt-greater-than-4GB-buffer-required) read them.
+    bool tail_low() const { return !pos_.empty(); }
     void close();
 
     bool valid() const { return base_ != nullptr; }
@@ -221,6 +232,9 @@ private:
     bool per_layer_ = false;
     std::vector<int32_t> layer_next_;   ///< [n_layers] -> that layer's next free slot
     std::vector<uint64_t> off_;         ///< plan v0.3 P6: slot offsets (slots + 1 entries) when sized
+    std::vector<uint64_t> pos_;         ///< arc-moe: each slot's address offset when the tail is laid out low
+    bool in_open_sized_ = false;        ///< arc-moe: open() runs for open_sized (byte "slots": no layout yet)
+    void lay_out_tail_low();
     int64_t admitted_ = 0;
 };
 
