From d1ba7f1e8c1dfa5e4b3b92c16c07e93261f905d1 Mon Sep 17 00:00:00 2001
From: arc-moe <arc-moe@users.noreply.github.com>
Date: Wed, 7 Oct 2026 12:07:33 +0000
Subject: [PATCH] sycl: the hc-read kernels read their arguments from device
 memory; gr_down_sliced at SIMD16 on Alchemist

unitrace on the A770 put gr_up_multi at 269 us per call (12,904 calls, the
largest decode kernel) for 6.5 MB of weights. Its 936-byte GrMulti was one
by-value kernel argument that every work-item copied into private memory
(OpCopyMemorySized; zeinfo private_size 29,952 per SIMD32 thread) and indexed
there by lane, group and token: ~38 MB of scratch traffic per call. The
same for gr_norm_split and gr_down_reduce. Each distinct GrMulti (a call
site's buffers, the same every window, so graphs replay the same pointer)
is now uploaded once through a side queue and the kernels take a reference
to it: private_size 0 on acm-g10.

gr_down_sliced spilled 1,952 bytes per thread at SIMD32 on acm-g10's 128
GRFs; its shuffles stay in 4-lane groups, so SIMD16 runs the same sums with
no spill.
---
 sycl/src/kernels/cuda/fused_gr.dp.cpp | 142 ++++++++++++++++++--------
 1 file changed, 99 insertions(+), 43 deletions(-)

diff --git a/sycl/src/kernels/cuda/fused_gr.dp.cpp b/sycl/src/kernels/cuda/fused_gr.dp.cpp
index a68a062..bd7efa8 100644
--- a/sycl/src/kernels/cuda/fused_gr.dp.cpp
+++ b/sycl/src/kernels/cuda/fused_gr.dp.cpp
@@ -7,6 +7,7 @@
 #include "strata/sycl_queue.hpp"
 #include "strata/core/emulate.hpp"
 #include "strata/kernels/fused_gr.hpp"
+#include <functional>
 #include "strata/kernels/bf16_bits.hpp"
 #include "strata/kernels/verify_kernels.hpp"
 
@@ -250,6 +251,57 @@ struct GrMulti {
     float* part2 = nullptr;    ///< SYCL port: [GRS_SLICES][kFusedGrMaxT][LR + HC] slice partials of the sliced kernel
 };
 
+// arc-moe: the kernels read GrMulti from device memory. Passed by value it became one 936-byte kernel argument the
+// kernel copied into private memory and indexed there with runtime values (a lane, a group, a token loop): on
+// acm-g10 that is 29,952 bytes of scratch per SIMD32 thread, and the decode window's hc-read kernels spent most of
+// their time on it (unitrace, A770: gr_up_multi 269 us per call for 6.5 MB of weights). Each distinct GrMulti (a
+// call site's buffers: the same on every window, so a graph replays the same pointer) is uploaded once, through a
+// side queue so that a queue being recorded into a graph is not touched; the kernels index it in global memory.
+const GrMulti* gr_dev(const GrMulti& m, dpct::queue_ptr q) {
+    // the key: every field's value (not the struct's bytes: its padding is not initialized)
+    std::string key;
+    key.reserve(1024);
+    auto put = [&key](const void* p, size_t n) { key.append(static_cast<const char*>(p), n); };
+    for (int k = 0; k < kFusedGrMaxT; ++k) {
+        const FusedGrArgs& a = m.a[k];
+        const void* ptrs[12] = {a.R, a.R_out, a.bo_prev, a.inj_prev, a.w_norm, a.w_down, a.w_up, a.w_inject,
+                                a.lo, a.rs, a.inject_out, a.mixed};
+        put(ptrs, sizeof ptrs);
+        put(&a.eps, sizeof a.eps);
+        const char ap = a.apply ? 1 : 0;
+        put(&ap, 1);
+    }
+    const void* tail[3] = {m.xn, m.part, m.part2};
+    put(tail, sizeof tail);
+    put(&m.T, sizeof m.T);
+    put(&m.nsplit, sizeof m.nsplit);
+    const sycl::context ctx = q->get_context();
+    const sycl::device dev = q->get_device();
+    struct Side { sycl::context ctx; sycl::device dev; sycl::queue q; };
+    static std::mutex mu;
+    static std::unordered_map<std::string, GrMulti*> cache;
+    static std::vector<Side> sides;
+    std::lock_guard<std::mutex> lk(mu);
+    key += std::to_string(std::hash<sycl::device>{}(dev));
+    if (auto it = cache.find(key); it != cache.end()) return it->second;
+    sycl::queue* side = nullptr;
+    for (Side& sd : sides)
+        if (sd.ctx == ctx && sd.dev == dev) side = &sd.q;
+    if (side == nullptr) {
+        sides.push_back({ctx, dev, sycl::queue(ctx, dev, sycl::property::queue::in_order())});
+        side = &sides.back().q;
+        for (Side& sd : sides)   // (push_back may have moved the earlier entries: look the new one up again)
+            if (sd.ctx == ctx && sd.dev == dev) side = &sd.q;
+    }
+    GrMulti* d = sycl::malloc_device<GrMulti>(1, *side);
+    side->memcpy(d, &m, sizeof m).wait();
+    if (cache.size() == 65536)
+        std::fprintf(stderr, "strata: fused_gr: 65536 distinct hc-read argument sets uploaded (kept: graphs may hold "
+                             "them) - is a caller passing fresh buffers every call?\n");
+    cache.emplace(std::move(key), d);
+    return d;
+}
